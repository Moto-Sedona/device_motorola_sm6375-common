hal_client_domain(hal_power_default, hal_thermal)

typeattribute hal_power_default mlstrustedsubject;

allow hal_power_default self:global_capability_class_set sys_nice;
unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default)

allow hal_power_default vendor_sysfs_touchpanel:dir search;
allow hal_power_default vendor_sysfs_touchpanel:file rw_file_perms;
allow hal_power_default vendor_sysfs_input:dir search;
allow hal_power_default vendor_sysfs_sensors:dir search;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file rw_file_perms;

allow hal_power_default system_server:process setsched;
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default appdomain:process setsched;
allow hal_power_default proc_stat:file r_file_perms;
allow hal_power_default powerhal_vendor_data_file:dir rw_dir_perms;
allow hal_power_default powerhal_vendor_data_file:file create_file_perms;
allow hal_power_default fwk_stats_service:service_manager find;
binder_call(hal_power_default, stats_service_server);

rw_dir_file(hal_power_default, proc_sched)
rw_dir_file(hal_power_default, sysfs_devices_system_cpu)
rw_dir_file(hal_power_default, vendor_sysfs_devfreq)
rw_dir_file(hal_power_default, vendor_sysfs_graphics)
rw_dir_file(hal_power_default, vendor_sysfs_kgsl)
rw_dir_file(hal_power_default, vendor_sysfs_scsi_host)

set_prop(hal_power_default, vendor_powerhal_prop)
